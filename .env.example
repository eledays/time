# Режим запуска: development, testing или production.
APP_ENV=development

# Секрет подписи сессий. В production обязателен уникальный ключ от 32 символов.
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=replace-with-a-random-string-at-least-32-characters


# --- База данных -----------------------------------------------------------

# URL базы в формате SQLAlchemy. Относительный SQLite-файл хранится в instance/.
DATABASE_URL=sqlite:///time.sqlite3


# --- Вход через Яндекс ID --------------------------------------------------

# ID и секрет OAuth-приложения из https://oauth.yandex.ru/.
# Указываются только вместе; в production обязательны.
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# Публичный адрес приложения без завершающего слеша. В production нужен HTTPS.
PUBLIC_URL=

# Разрешённые Host-заголовки без схемы, через запятую. Пример: example.ru,www.example.ru
TRUSTED_HOSTS=


# --- Безопасность и ограничения -------------------------------------------

# Передавать cookie сессии только по HTTPS. Для production установите true.
SESSION_COOKIE_SECURE=false

# Максимальный размер HTTP-запроса в байтах: от 16384 до 10485760.
MAX_CONTENT_LENGTH=1048576

# Максимальное количество точек в одном маршруте: от 2 до 100.
MAX_ROUTE_POINTS=20

# Максимальная длина названий и описаний: от 32 до 2000 символов.
MAX_TEXT_LENGTH=200

# Хранилище счётчиков ограничения запросов.
# memory:// подходит для одного процесса; нескольким процессам нужно общее хранилище.
RATE_LIMIT_STORAGE_URI=memory://


# --- Юридические документы ------------------------------------------------

# ФИО, наименование ИП или организации — оператор персональных данных.
# Обязательно в production.
LEGAL_OPERATOR_NAME=

# Email для обращений пользователей по данным и условиям. Обязателен в production.
LEGAL_OPERATOR_EMAIL=

# ИНН, ОГРН, ОГРНИП или другой идентификатор оператора, если он есть.
LEGAL_OPERATOR_ID=

# Фактическое место основной базы данных. Обязательно в production.
LEGAL_DATA_STORAGE_LOCATION=Российская Федерация

# Версия документов сохраняется вместе со временем их принятия пользователем.
LEGAL_DOCUMENT_VERSION=1.0

# Дата вступления документов в силу в формате YYYY-MM-DD. Обязательна в production.
LEGAL_EFFECTIVE_DATE=

# Срок удаления данных из резервных копий, если они создаются: от 0 до 365 дней.
LEGAL_BACKUP_RETENTION_DAYS=30
